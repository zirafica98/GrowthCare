# Edge Function secrets — set with `supabase secrets set --env-file supabase/.env`
# NEVER commit the real file and NEVER expose these to the Angular app.

# ocr-extract
OCR_PROVIDER=none            # google-vision | none
GOOGLE_VISION_API_KEY=
ALLOWED_ORIGIN=https://your-app.example.com

# send-reminders
SUPABASE_SERVICE_ROLE_KEY=   # server-side only
VAPID_PUBLIC_KEY=            # also goes into environment.ts (public)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
